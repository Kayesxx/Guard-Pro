{
  "manifest_version": 3,
  "name": "FB Guard Pro",
  "version": "6.2",
  "description": "Facebook & YouTube restricted word bypass — Offline + Gemini AI",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "*://*.facebook.com/*",
    "*://*.youtube.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*",
    "https://trends.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.facebook.com/*",
        "*://*.youtube.com/*",
        "*://studio.youtube.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "FB Guard Pro"
  },
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
